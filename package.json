{
  "name": "opencode-doodba-dev",
  "version": "0.1.0",
  "description": "OpenCode plugin for Doodba (Odoo) development — provides Odoo source indexing and AI-assisted exploration tools.",
  "type": "module",
  "main": ".opencode/plugins/doodba-dev.js",
  "exports": {
    ".": ".opencode/plugins/doodba-dev.js"
  },
  "files": [
    ".opencode/",
    "src/"
  ],
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "lint": "eslint src tests .opencode/plugins",
    "lint:fix": "eslint src tests .opencode/plugins --fix",
    "format": "prettier --write 'src/**/*.{ts,js,mjs}' 'tests/**/*.{ts,js,mjs}' '.opencode/plugins/**/*.{ts,js,mjs}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,mjs}' 'tests/**/*.{ts,js,mjs}' '.opencode/plugins/**/*.{ts,js,mjs}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.19",
    "fast-xml-parser": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.12",
    "eslint": "^10.2.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
